{
  "name": "@unisat/descriptor-service",
  "version": "0.1.0",
  "description": "BIP-380 singlesig output descriptors for UniSat Wallet",
  "private": true,
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*",
    "src/**/*",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "import": "./lib/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf lib",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "bitcoin",
    "descriptor",
    "bip380",
    "unisat"
  ],
  "author": "UniSat",
  "license": "MIT",
  "dependencies": {
    "@bitcoinerlab/secp256k1": "^1.0.5",
    "bip32": "^4.0.0",
    "bitcoinjs-lib": "^6.1.6"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "tsup": "^7.2.0",
    "typescript": "^5.2.0",
    "vitest": "^0.34.0"
  }
}
